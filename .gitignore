# Local Claude Code session directory
.claude/

# Auto-generated stub - must never sit inside the drop-in folder
# (a reader would load it as instructions and contaminate Test B / Test C)
map/CLAUDE.md
map/**/CLAUDE.md

# Working notes - process scaffolding, not part of the submission
tasks/
scratchpad/

# Microsoft Office owner/lock files (~$catalog.md and the like)
# Word drops these beside any file it opens. They hold an exclusive write lock
# while open, and a killed Word leaves them behind inside the drop-in folder.
~$*
